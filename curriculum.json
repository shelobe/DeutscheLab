[{"level": "A1", "title": "Greetings and introductions", "skill": "vocabulary", "q": "Hallo means…", "opts": ["Hello", "Goodbye", "Please"], "ans": 0, "why": "Hallo is a greeting.", "words": [["Hallo", "Hello"], ["Guten Tag", "Good day"], ["Auf Wiedersehen", "Goodbye"]]}, {"level": "A1", "title": "Nouns and articles", "skill": "articles", "q": "Choose the correct article: ___ Tisch", "opts": ["die", "das", "der"], "ans": 2, "why": "Tisch is masculine: der Tisch.", "words": [["der Tisch", "table"], ["die Lampe", "lamp"], ["das Buch", "book"]]}, {"level": "A1", "title": "Present-tense verbs", "skill": "verbs", "q": "Wir ___ Deutsch.", "opts": ["lernen", "lernt", "lerne"], "ans": 0, "why": "Wir takes the -en ending.", "words": [["ich lerne", "I learn"], ["du lernst", "you learn"], ["wir lernen", "we learn"]]}, {"level": "A1", "title": "Basic word order", "skill": "syntax", "q": "Which sentence is correct?", "opts": ["Heute ich gehe einkaufen.", "Heute gehe ich einkaufen.", "Heute einkaufen ich gehe."], "ans": 1, "why": "In statements, the conjugated verb stays second.", "words": [["Heute gehe ich.", "Today I go."], ["Ich gehe heute.", "I go today."], ["Wo wohnst du?", "Where do you live?"]]}, {"level": "A2", "title": "Accusative articles", "skill": "cases", "q": "Ich sehe ___ Hund.", "opts": ["den", "dem", "der"], "ans": 0, "why": "Masculine der becomes den in accusative.", "words": [["der Hund → den Hund", "the dog (object)"], ["einen Apfel", "an apple (object)"], ["die Katze", "the cat (object)"]]}, {"level": "A2", "title": "Dative articles", "skill": "cases", "q": "Ich helfe ___ Frau.", "opts": ["die", "der", "den"], "ans": 1, "why": "Helfen takes dative; die Frau becomes der Frau.", "words": [["mit dem Hund", "with the dog"], ["bei der Frau", "at the woman's"], ["mit einem Kind", "with a child"]]}, {"level": "A2", "title": "Perfect tense", "skill": "verbs", "q": "Gestern ___ ich gekocht.", "opts": ["bin", "habe", "werde"], "ans": 1, "why": "Kochen forms Perfekt with haben.", "words": [["ich habe gelernt", "I learned"], ["sie ist gefahren", "she traveled"], ["wir haben gekocht", "we cooked"]]}, {"level": "A2", "title": "Separable verbs", "skill": "verbs", "q": "Ich ___ um sieben Uhr ___.", "opts": ["stehe … auf", "aufstehe … —", "stehe … an"], "ans": 0, "why": "Aufstehen separates in a main clause.", "words": [["ich stehe auf", "I get up"], ["ich kaufe ein", "I shop"], ["ich rufe an", "I call"]]}, {"level": "B1", "title": "Subordinate clauses", "skill": "syntax", "q": "Ich bleibe zu Hause, weil ich krank ___.", "opts": ["bin", "sein", "ist"], "ans": 0, "why": "After weil, the conjugated verb goes to the end.", "words": [["weil ich müde bin", "because I am tired"], ["dass er kommt", "that he is coming"], ["ob sie Zeit hat", "whether she has time"]]}, {"level": "B1", "title": "Relative clauses", "skill": "syntax", "q": "Das ist der Mann, ___ hier arbeitet.", "opts": ["den", "der", "dem"], "ans": 1, "why": "The subject of the relative clause is nominative masculine: der.", "words": [["der Mann, der…", "the man who…"], ["die Frau, die…", "the woman who…"], ["das Kind, das…", "the child that…"]]}, {"level": "B1", "title": "Konjunktiv II", "skill": "verbs", "q": "Wenn ich mehr Zeit hätte, ___ ich reisen.", "opts": ["werde", "würde", "habe"], "ans": 1, "why": "Hypothetical statements often use würde + infinitive.", "words": [["ich würde gern…", "I would like to…"], ["wenn ich könnte…", "if I could…"], ["ich hätte gern…", "I would like to have…"]]}, {"level": "B1", "title": "Prepositions and cases", "skill": "cases", "q": "Ich interessiere mich ___ Musik.", "opts": ["an", "für", "mit"], "ans": 1, "why": "Sich interessieren für takes accusative.", "words": [["sich interessieren für", "to be interested in"], ["warten auf", "to wait for"], ["sprechen mit", "to speak with"]]}, {"level": "B2", "title": "Passive voice", "skill": "grammar", "q": "Der Brief ___ gestern geschrieben.", "opts": ["wird", "wurde", "würde"], "ans": 1, "why": "Past passive uses wurde + past participle.", "words": [["wird gemacht", "is being done"], ["wurde gemacht", "was done"], ["ist gemacht worden", "has been done"]]}, {"level": "B2", "title": "Advanced connectors", "skill": "syntax", "q": "___ es regnete, gingen wir spazieren.", "opts": ["Obwohl", "Weil", "Damit"], "ans": 0, "why": "Obwohl introduces a concession: although.", "words": [["obwohl", "although"], ["dennoch", "nevertheless"], ["während", "while"]]}, {"level": "B2", "title": "Reported speech", "skill": "grammar", "q": "Er sagt, er ___ keine Zeit.", "opts": ["habe", "hatte", "hätte"], "ans": 0, "why": "Konjunktiv I (er habe) is used for reported speech.", "words": [["er habe gesagt", "he reportedly said"], ["sie sei gekommen", "she reportedly came"], ["laut Bericht", "according to the report"]]}, {"level": "B2", "title": "Nuanced vocabulary", "skill": "vocabulary", "q": "Was bedeutet „allerdings“ hier: „Das ist allerdings schwierig“?", "opts": ["however", "indeed", "possibly"], "ans": 1, "why": "Here allerdings emphasizes the statement: indeed.", "words": [["allerdings", "indeed / however"], ["hingegen", "by contrast"], ["durchaus", "certainly / quite"]]}, {"level": "A1", "title": "Diagnostic", "skill": "articles", "q": "___ Mädchen spielt.", "opts": ["Der", "Die", "Das"], "ans": 2, "why": "-chen nouns are neuter.", "words": []}, {"level": "A1", "title": "Diagnostic", "skill": "verbs", "q": "Du ___ in Berlin.", "opts": ["wohnst", "wohne", "wohnen"], "ans": 0, "why": "Du takes -st.", "words": []}, {"level": "A1", "title": "Diagnostic", "skill": "vocabulary", "q": "„Bitte“ can mean…", "opts": ["Please", "Yesterday", "Always"], "ans": 0, "why": "Bitte means please or you're welcome.", "words": []}, {"level": "A1", "title": "Diagnostic", "skill": "syntax", "q": "___ du Kaffee?", "opts": ["Trinkst", "Trinken", "Trinkt"], "ans": 0, "why": "Yes/no questions begin with the conjugated verb.", "words": []}, {"level": "A2", "title": "Diagnostic", "skill": "articles", "q": "Ich kaufe ___ Apfel.", "opts": ["ein", "einen", "einem"], "ans": 1, "why": "Masculine accusative uses einen.", "words": []}, {"level": "A2", "title": "Diagnostic", "skill": "cases", "q": "Sie fährt mit ___ Bus.", "opts": ["den", "der", "dem"], "ans": 2, "why": "Mit always takes dative.", "words": []}, {"level": "A2", "title": "Diagnostic", "skill": "verbs", "q": "Wir ___ gestern nach Hause gegangen.", "opts": ["haben", "sind", "werden"], "ans": 1, "why": "Gehen uses sein in Perfekt.", "words": []}, {"level": "A2", "title": "Diagnostic", "skill": "syntax", "q": "Morgen ___ ich meine Mutter an.", "opts": ["rufe", "anrufe", "rufen"], "ans": 0, "why": "Separable prefix goes at the end.", "words": []}, {"level": "B1", "title": "Diagnostic", "skill": "cases", "q": "Trotz ___ Wetters gehen wir raus.", "opts": ["des schlechten", "dem schlechten", "das schlechte"], "ans": 0, "why": "Trotz commonly takes genitive.", "words": []}, {"level": "B1", "title": "Diagnostic", "skill": "syntax", "q": "Ich weiß nicht, ob er morgen ___.", "opts": ["kommt", "kommen", "komme"], "ans": 0, "why": "The verb comes last in an ob-clause.", "words": []}, {"level": "B1", "title": "Diagnostic", "skill": "vocabulary", "q": "„sich entscheiden“ means…", "opts": ["to apologize", "to decide", "to remember"], "ans": 1, "why": "Sich entscheiden means to decide.", "words": []}, {"level": "B1", "title": "Diagnostic", "skill": "verbs", "q": "An deiner Stelle ___ ich früher gehen.", "opts": ["werde", "würde", "habe"], "ans": 1, "why": "Advice can use würde.", "words": []}, {"level": "B2", "title": "Diagnostic", "skill": "grammar", "q": "Das Problem muss sofort ___ werden.", "opts": ["lösen", "gelöst", "löste"], "ans": 1, "why": "Modal passive: muss + participle + werden.", "words": []}, {"level": "B2", "title": "Diagnostic", "skill": "syntax", "q": "Er ging, ohne sich zu ___.", "opts": ["verabschieden", "verabschiedet", "verabschiedete"], "ans": 0, "why": "Ohne ... zu takes an infinitive.", "words": []}, {"level": "B2", "title": "Diagnostic", "skill": "vocabulary", "q": "„Es kommt darauf an“ means…", "opts": ["It depends", "It arrives", "It is over"], "ans": 0, "why": "This expression means it depends.", "words": []}, {"level": "B2", "title": "Diagnostic", "skill": "grammar", "q": "Er behauptet, er ___ nichts davon gewusst.", "opts": ["habe", "hat", "wird"], "ans": 0, "why": "Reported speech uses Konjunktiv I.", "words": []}]